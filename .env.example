JARVIS_HOST=127.0.0.1
JARVIS_PORT=3000
JARVIS_NAME=Neko

AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen2.5:3b
AI_API_KEY=
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=60000

JARVIS_DATA_DIR=./data

HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

SEARXNG_URL=
SPOTIFY_ACCESS_TOKEN=
JARVIS_FILES_ROOT=./workspace

# Piper uses only the built-in British Jarvis voices and downloads the selected
# ONNX model + JSON automatically into JARVIS_DATA_DIR/models/piper.
# Options: en_GB-jarvis-medium, en_GB-jarvis-high
PIPER_BIN=piper
PIPER_VOICE=en_GB-jarvis-medium

BROWSER_EXECUTABLE_PATH=
BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=false

GOOGLE_ACCESS_TOKEN=
DISCORD_BOT_TOKEN=
GITHUB_TOKEN=

JARVIS_PAIRING_CODE=
AGENT_HEARTBEAT_SECONDS=30

JELLYFIN_URL=
JELLYFIN_API_KEY=
PLEX_URL=
PLEX_TOKEN=
KODI_URL=
KODI_USERNAME=
KODI_PASSWORD=
LOCAL_MUSIC_DIR=

# JSON object of named SSH hosts. Prefer private-key paths over passwords.
# Example: {"server":{"host":"192.168.1.20","port":22,"username":"root","privateKeyPath":"/home/user/.ssh/id_ed25519"}}
SSH_HOSTS_JSON={}

# Optional online/no-API-key TTS fallback. Install edge-tts separately.
EDGE_TTS_BIN=edge-tts
EDGE_TTS_VOICE=en-GB-SoniaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz

# Strongly recommended when JARVIS_HOST is not loopback.
# Regular /api/v1 endpoints accept Authorization: Bearer <token>.
JARVIS_API_TOKEN=

# Optional master secret/passphrase for encrypted credentials.
# If empty, Jarvis generates data/secrets.key locally.
JARVIS_SECRET_KEY=

ADB_BIN=adb

HUE_BRIDGE_URL=
HUE_USERNAME=

# Named local devices, for example:
# {"desk":{"url":"http://192.168.1.50"}}
SHELLY_DEVICES_JSON={}
TASMOTA_DEVICES_JSON={}
